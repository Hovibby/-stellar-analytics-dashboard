# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database
*.sqlite
*.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Temporary folders
tmp/
temp/

# Local backup artifacts
backups/**/*.dump
backups/**/*.sha256
backups/**/*.history

# Playwright — keep baseline snapshots, ignore test artefacts
packages/e2e/test-results/
packages/e2e/playwright-report/
# Actual / diff images produced during a failing visual regression run
packages/e2e/tests/__snapshots__/**/*-actual.png
packages/e2e/tests/__snapshots__/**/*-diff.png
# Baseline .png files ARE committed — do not ignore them
