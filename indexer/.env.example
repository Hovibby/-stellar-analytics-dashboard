# =============================================================================
# Stellar Analytics Indexer – Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables are optional unless marked REQUIRED.

# -----------------------------------------------------------------------------
# Stellar Network
# -----------------------------------------------------------------------------

# Which Stellar network to index.
# Allowed values: testnet | mainnet | futurenet
# Default: testnet
STELLAR_NETWORK=testnet

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# REQUIRED for data persistence.
# If not set, the indexer runs in dry-run mode (no data is written).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/stellar_analytics

# -----------------------------------------------------------------------------
# Polling
# -----------------------------------------------------------------------------

# How often (in milliseconds) to poll Horizon for the latest ledger.
# Default: 5000 (5 seconds)
POLL_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# Backfill (Issues #38 & #45)
# -----------------------------------------------------------------------------

# Number of parallel workers used during backfill.
# Higher values increase throughput but may trigger Horizon rate-limiting.
# Default: 4
BACKFILL_CONCURRENCY=4

# Number of ledgers processed per batch during backfill.
# Default: 10
BACKFILL_BATCH_SIZE=10

# Delay in milliseconds between batches to avoid Horizon rate-limiting.
# Default: 200
BACKFILL_BATCH_DELAY_MS=200

# -----------------------------------------------------------------------------
# Server Ports
# -----------------------------------------------------------------------------

# HTTP health-check endpoint port.
# Default: 3001
HEALTH_PORT=3001

# WebSocket real-time broadcast server port.
# Default: 8080
WS_PORT=8080

# -----------------------------------------------------------------------------
# Logging (Issue #47)
# -----------------------------------------------------------------------------

# Minimum log level to emit.
# Allowed values: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info

# Set to "true" to enable human-readable coloured output (development only).
# Default: false
LOG_PRETTY=false

# Directory where rotating log files are written.
# Default: ./logs  (relative to the indexer package root)
LOG_DIR=logs

# =============================================================================
# Alerting (Issue #143)
# =============================================================================

# Enable/disable the entire alerting system.
# Default: false
ALERTING_ENABLED=false

# ── Slack Alerts ───────────────────────────────────────────────────────────

# Enable Slack alerts.
# Default: false
SLACK_ALERTS_ENABLED=false

# Slack incoming webhook URL for posting alerts.
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
# See: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Cooldown period between Slack alerts (in milliseconds).
# Prevents alert spam for the same error.
# Default: 300000 (5 minutes)
SLACK_ALERT_COOLDOWN_MS=300000

# ── Email Alerts ───────────────────────────────────────────────────────────

# Enable email alerts.
# Default: false
EMAIL_ALERTS_ENABLED=false

# SMTP host for sending emails.
# Example: smtp.gmail.com
EMAIL_SMTP_HOST=

# SMTP port (typically 587 for TLS or 465 for SSL).
# Default: 587
EMAIL_SMTP_PORT=587

# SMTP username (usually your email address).
EMAIL_SMTP_USER=

# SMTP password (for Gmail, use an app-specific password).
# See: https://support.google.com/accounts/answer/185833
EMAIL_SMTP_PASSWORD=

# Email address to send alerts from.
# Default: indexer@stellar-analytics.local
EMAIL_FROM_ADDRESS=indexer@stellar-analytics.local

# Comma-separated list of email addresses to receive alerts.
# Example: ops@example.com,team@example.com
EMAIL_TO_ADDRESSES=

# Cooldown period between email alerts (in milliseconds).
# Prevents alert spam for the same error.
# Default: 300000 (5 minutes)
EMAIL_ALERT_COOLDOWN_MS=300000

# ── Alert Thresholds ──────────────────────────────────────────────────────

# Alert if error rate exceeds this percentage.
# Example: 10 means alert if more than 10% of cycles fail.
# Default: 10
ALERT_ERROR_RATE_PERCENT=10

# Alert if dead letter queue size exceeds this threshold.
# Example: 100 means alert if more than 100 failed ledgers are queued.
# Default: 100
ALERT_DLQ_SIZE_THRESHOLD=100

# Alert when circuit breaker opens for Horizon API.
# Default: true
ALERT_CIRCUIT_BREAKER_OPEN=true
